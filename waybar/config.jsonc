// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "width": 1870, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    "margin-top": 0,
    // Choose the order of the modules
    "modules-left": [
		"custom/os_button",
        "custom/sep",
        "tray",
        "custom/sep",
        "hyprland/workspaces"
    ],
    "modules-center": [
		"clock"
    ],
    "modules-right": [
        "keyboard-state",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "backlight",
        "custom/sep",
        "battery",
        "custom/sep",
        "custom/power"
    ],
    // Modules configuration
    "hyprland/workspaces": {
         "all-outputs": true,
         "format": "{icon}",
//         "persistent-workspaces": {
//            "01": [],
//            "02": [],
//            "03": [],
//            "04": [],
//            "05": [],
//            "06": [],
//            "07": [],
//            "08": [],
//            "09": [],
//            "10": []
//        },
         "sort-by-number": true,
         "on-click": "activate",
         "format-icons": {
             "urgent": "",
             "active": "",
             "default": "",
             "empty": ""
        }
    },
    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10,
    },
    "clock": {
        "timezone": "Asia/Jakarta",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt":"  {:%A, %d %B %Y}",
        "format": "󰥔  {:%H:%M WIB}"
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "  {volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        //"format-icons": ["", "", "", "", ""]
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "custom/os_button": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show drun -i -fn JetBrainsMono Nerd Font"
    },
    "custom/power": {
        "format" : "",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    },
    "custom/sep": {
		"format": "|",
		"tooltip": false
    }
}
